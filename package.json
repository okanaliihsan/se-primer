{
  "name": "se-primer",
  "version": "2.0.0",
  "description": "SE Primer v2 — davranıştan öğrenen küçük bir modelle uyumlanan, yazılım mühendisliği için oynanan kitap (YZM301)",
  "private": true,
  "scripts": {
    "build": "node tools/build.js",
    "serve": "node tools/build.js && http-server . -p 8080 -c-1 -s",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:demo": "cypress run --spec cypress/e2e/demo2.cy.js",
    "test": "start-server-and-test serve http://localhost:8080 cy:run",
    "eval": "node eval/run-eval.js",
    "eval:baseline": "node eval/run-eval.js --baseline"
  },
  "devDependencies": {
    "cypress": "^13.17.0",
    "http-server": "^14.1.1",
    "start-server-and-test": "^2.0.11"
  }
}
